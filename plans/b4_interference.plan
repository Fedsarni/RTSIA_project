# B4 - Interference. Level = stress-ng workers (4 as in the reference project, 12 = all cores).
# systems      stress        level  isolation  reps  duration_s  freq_hz
# SemIf: every stressor, two levels
semif          cpu_matrix    4      none       3     180         2
semif          cpu_matrix    12     none       3     180         2
semif          cpu_fft       4      none       3     180         2
semif          cpu_fft       12     none       3     180         2
semif          mem_stream    4      none       3     180         2
semif          mem_stream    12     none       3     180         2
semif          mem_vm        4      none       3     180         2
semif          mem_vm        12     none       3     180         2
semif          cache_l1      4      none       3     180         2
semif          cache_l1      12     none       3     180         2
semif          sched_switch  4      none       3     180         2
semif          sched_switch  12     none       3     180         2
semif          io_hdd        4      none       3     180         2
semif          io_hdd        12     none       3     180         2
# Gemma: the most representative stressors, level 4
gemma          cpu_matrix    4      none       3     300         2
gemma          mem_stream    4      none       3     300         2
gemma          sched_switch  4      none       3     300         2
gemma          io_hdd        4      none       3     300         2
