
# DA RIVEDERE SULLA BASE DEI RISULTATI DI B4
# B5 - Isolation on the most harmful stressors (to be confirmed after B4).
# pin = models on cores 0-7, stressor on 8-11; prio = SCHED_FIFO on models (needs 'sudo -v' first).
# systems      stress        level  isolation  reps  duration_s  freq_hz
semif          mem_stream    12     pin        3     180         2
semif          mem_stream    12     prio       3     180         2
semif          mem_stream    12     pin_prio   3     180         2
semif          sched_switch  12     pin        3     180         2
semif          sched_switch  12     prio       3     180         2
semif          sched_switch  12     pin_prio   3     180         2
semif          mem_vm        12     pin        3     180         2
semif          mem_vm        12     prio       3     180         2
semif          mem_vm        12     pin_prio   3     180         2
# Gemma under CPU saturation: can isolation protect the llama.cpp host thread
# that feeds the GPU (the 'control path' slowdown seen in the reference project)?
gemma          mem_stream    12     pin        3     300         2
gemma          mem_stream    12     prio       3     300         2
gemma          mem_stream    12     pin_prio   3     300         2
gemma          sched_switch  12     pin        3     300         2
gemma          sched_switch  12     prio       3     300         2
gemma          sched_switch  12     pin_prio   3     300         2
gemma          mem_vm        12     pin        3     300         2
gemma          mem_vm        12     prio       3     300         2
gemma          mem_vm        12     pin_prio   3     300         2

